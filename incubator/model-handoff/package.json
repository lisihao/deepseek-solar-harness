{
  "name": "@lisihao/dsh-solar-model-handoff",
  "version": "0.1.0-dev.0",
  "description": "GPT-6 luna session handoff with human clarification and confirmed replayable history checkpoints before model switches.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": {
    "email": "haogege1977@gmail.com"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "react": "^18.2.0"
  }
}
