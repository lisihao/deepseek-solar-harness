{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@lisihao/dsh-solar-native-resident/contracts": ["incubator/native-resident/src/contracts.ts"]
    },
    "noEmit": true
  },
  "include": ["incubator/native-resident/src/**/*.ts", "incubator/native-resident/tests/**/*.ts", "incubator/native-collaboration/src/**/*.ts", "incubator/native-collaboration/tests/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/lib/**", "**/node_modules/**"]
}
