{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@lisihao/dsh-solar-native-resident/contracts": [
        "incubator/native-resident/src/contracts.ts"
      ],
      "@lisihao/dsh-solar-native-collaboration/studio-contracts": [
        "incubator/native-collaboration/src/studio-contract.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "incubator/*/src/**/*.ts",
    "incubator/*/tests/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "**/lib/**",
    "**/node_modules/**"
  ]
}
