{
  "name": "@lisihao/dsh-code-harness-governance",
  "version": "0.3.1",
  "description": "Fail-closed Code-as-Harness governance bundle for DeepSeek-Solar-Harness",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./invariant": "./invariant.js",
    "./state": "./lib/state.js",
    "./preflight": "./lib/preflight.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-governed": "./bin/dsh-governed.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "runtime/",
    "index.js",
    "invariant.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pack:plugin": "npm pack",
    "prepack": "node scripts/build-client.mjs --check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
