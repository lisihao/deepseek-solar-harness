{
  "name": "dsh-solar-v4-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": { "node": "^22.19 || >=24" },
  "workspaces": ["plugins/*"],
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:plugin": "node tools/plugin-test.mjs",
    "homepage": "node tools/homepage.mjs",
    "homepage:check": "node tools/homepage.mjs --check && node tools/installed-plugin-guide.mjs --check && python3 tools/check-curated-packages.py && bash tools/tests/curated-installer.test.sh && python3 tools/tests/curated-history.test.py",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:plugin && pnpm homepage:check"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@openai/codex": "0.153.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.6.7"
  }
}
