{
  "name": "dsh-solar-v4-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs && node tools/build-rlm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:plugin": "node tools/plugin-test.mjs && node tools/rlm-plugin-test.mjs",
    "homepage": "node tools/homepage.mjs",
    "homepage:check": "node tools/homepage.mjs --check",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:plugin && pnpm homepage:check",
    "build:rlm": "node tools/build-rlm.mjs",
    "capsule:rlm": "node tools/rlm-capsule.mjs",
    "test:plugin:rlm": "node tools/rlm-plugin-test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex": "0.153.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.6.7"
  }
}
