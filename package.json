{
  "name": "dsh-solar-v4-development",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs && node tools/build-rlm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:plugin": "node tools/plugin-test.mjs && node tools/rlm-plugin-test.mjs",
    "homepage": "node tools/homepage.mjs",
    "homepage:check": "node tools/homepage.mjs --check",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:arc && pnpm test:recursion && pnpm test:quality && pnpm test:plugin && pnpm homepage:check",
    "build:rlm": "node tools/build-rlm.mjs",
    "capsule:rlm": "node tools/rlm-capsule.mjs",
    "test:plugin:rlm": "node tools/rlm-plugin-test.mjs",
    "test:arc": "node --test tools/rlm-arc-pilot/baseline.test.mjs tools/rlm-arc-pilot/attachment-relay.test.mjs tools/rlm-arc-pilot/broker.test.mjs tools/rlm-arc-pilot/ledger.test.mjs tools/rlm-arc-pilot/run.test.mjs",
    "test:arc:native": "node tools/rlm-arc-pilot/native-worker.test.mjs",
    "test:recursion": "node --test tools/rlm-recursion-pilot/tasks.test.mjs tools/rlm-recursion-pilot/control.test.mjs tools/rlm-recursion-pilot/run.test.mjs tools/rlm-recursion-pilot/resume.test.mjs tools/rlm-recursion-pilot/revalidate.test.mjs tools/rlm-recursion-pilot/network-profile.test.mjs",
    "test:recursion:native": "node tools/rlm-recursion-pilot/native-acceptance.mjs",
    "test:quality": "node --test tools/rlm-quality-pilot/task.test.mjs tools/rlm-quality-pilot/run.test.mjs tools/rlm-quality-pilot/long-read.test.mjs tools/rlm-quality-pilot/three-arm.test.mjs tools/rlm-quality-pilot/recovery.test.mjs tools/rlm-quality-pilot/controlled.test.mjs",
    "test:quality:native": "node tools/rlm-quality-pilot/native-acceptance.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex": "0.153.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "4.6.7",
    "undici-long-read": "npm:undici@7.30.1"
  }
}
